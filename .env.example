# ---- Shopify (catalog source; synced offline, not called per query) ----
SHOPIFY_STORE_DOMAIN=b607ea-2b.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_REST_VERSION=2024-01
SHOPIFY_GRAPHQL_VERSION=2024-10

# ---- Wizzy (search engine) ----
# Base URL confirmed by probe: POST {BASE}/products/search
WIZZY_BASE_URL=https://api.wizzy.ai/v1
WIZZY_STORE_ID=
WIZZY_API_KEY=
# Secret is ONLY for private/admin endpoints (products/save, synonyms...).
# Never expose it client-side; /products/search does NOT need it.
WIZZY_STORE_SECRET=

# ---- LLM (intent -> English keywords) ----
# Which provider to use: anthropic | openai. Falls back to the
# rule-based lexicon in lexicon.py when the key is missing or fails.
LLM_PROVIDER=anthropic
#
# Sarvam AI slots in here later (better Indic + code-mixing).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# Only needed when the key is an ORG key rather than a workspace-scoped one.
# Find it at console.anthropic.com -> Settings -> Workspaces (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Sarvam AI (Indic speech-to-text, and optionally the intent LLM) ----
# Auth header is  api-subscription-key: <key>   (not Bearer).
# STT  : POST https://api.sarvam.ai/speech-to-text
# Chat : POST https://api.sarvam.ai/v1/chat/completions
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_MODEL=sarvam-105b-conversations
# unknown = auto language ID; or en-IN / hi-IN / kn-IN to pin it
SARVAM_STT_LANGUAGE=unknown
